#!/bin/bash
set -e

# Update desktop database (idempotent)
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database /usr/share/applications || true
fi

# Update icon cache (idempotent)
gtk-update-icon-cache /usr/share/icons/hicolor 2>/dev/null || true

# Resolve the install dir. electron-builder installs under /opt/<productName>
# which for Open Design is "/opt/Open Design" (with a space); the executable
# name is "open-design". Prefer the real install dir if present.
INSTALL_PREFIX=""
for candidate in "/opt/Open Design" "/opt/open-design" /usr/lib/open-design /usr/lib/"Open Design"; do
    if [ -d "$candidate" ]; then
        INSTALL_PREFIX="$candidate"
        break
    fi
done

# Set chrome-sandbox permissions so the Electron sandbox works.
if [ -n "$INSTALL_PREFIX" ]; then
    sandbox="$INSTALL_PREFIX/chrome-sandbox"
    if [ -f "$sandbox" ]; then
        chown root:root "$sandbox"
        chmod 4755 "$sandbox"
    fi
fi

# Generate AppArmor profile if apparmor_parser is available. Open Design spawns
# child processes (daemon, web sidecar, agent CLIs) so the profile must allow
# userns + broad config writes under ~/.config/Open Design.
if command -v apparmor_parser >/dev/null 2>&1 && [ -n "$INSTALL_PREFIX" ]; then    PROFILE_PATH="/etc/apparmor.d/open-design"
    BIN_PATH="$INSTALL_PREFIX/open-design.bin"

    if [ ! -f "$PROFILE_PATH" ]; then
        printf '%s\n' \
            "#include <tunables/global>" \
            "" \
            "${BIN_PATH} {" \
            "  #include <abstractions/base>" \
            "  userns," \
            "" \
            "  $INSTALL_PREFIX/** r," \
            "  $INSTALL_PREFIX/** rwlix," \
            "" \
            "  owner @{HOME}/.config/Open Design/** rwlk," \
            "  owner @{HOME}/.config/Open Design* rw," \
            "" \
            "  /usr/share/** r," \
            "  /etc/** r," \
            "" \
            "  network," \
            "}" > "$PROFILE_PATH"
    fi

    apparmor_parser -r "$PROFILE_PATH" || true
fi

# --- Headless daemon CLI (issue #2) ---
# after-pack.js ships an `open-design-cli` wrapper next to the GUI launcher.
# Expose it on PATH as /usr/local/bin/open-design (NOT `od`: /usr/bin/od is
# GNU coreutils' octal dump and would collide). /usr/local/bin is used instead
# of /usr/bin to avoid dpkg file conflicts; it is on the default PATH.
if [ -n "$INSTALL_PREFIX" ] && [ -x "$INSTALL_PREFIX/open-design-cli" ]; then
    ln -sf "$INSTALL_PREFIX/open-design-cli" /usr/local/bin/open-design
fi

# --- systemd user service (issue #2) ---
# Ships the unit file; users opt in with:
#   systemctl --user enable --now open-design
# (postinst runs as root and cannot enable user units on anyone's behalf.)
UNIT_DIR="/usr/lib/systemd/user"
UNIT_FILE="$UNIT_DIR/open-design.service"
if [ -n "$INSTALL_PREFIX" ] && [ -x "$INSTALL_PREFIX/open-design-cli" ]; then
    mkdir -p "$UNIT_DIR"
    cat > "$UNIT_FILE" <<UNIT_EOF
[Unit]
Description=Open Design headless daemon (MCP)
Documentation=https://github.com/cuongducle/open-design-linux
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/open-design
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
UNIT_EOF
    chmod 644 "$UNIT_FILE"
fi
